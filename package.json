{
  "name": "@zthun/roadblock",
  "version": "0.0.0",
  "description": "A micro application that handles token based authentication for zthun scoped domain apps.",
  "author": "Anthony Bonta",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/zthun/roadblock"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "clean": "rimraf --glob 'coverage' '*.tgz' '*.log' 'packages/**/dist' 'packages/**/*.tgz' 'packages/**/*.log' 'packages/**/stats'",
    "check": "tsc --noEmit",
    "test": "vitest run --coverage",
    "lint": "eslint",
    "build": "lerna run build",
    "make": "yarn clean && yarn lint && yarn test && yarn build"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-angular": "^21.2.3",
    "@types/express": "^5.0.6",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.3",
    "@zthun/janitor-eslint-config": "^21.2.4",
    "@zthun/janitor-ts-config": "^21.1.3",
    "@zthun/janitor-vite": "^21.2.4",
    "eslint": "^10.12.0",
    "husky": "^9.1.7",
    "lerna": "^10.0.1",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "packageManager": "yarn@4.18.1"
}
